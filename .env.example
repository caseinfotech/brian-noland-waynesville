# MLS Grid access token.
# Demo/test tokens authenticate against api-demo.mlsgrid.com (see lib/mlsgrid.ts).
MLS_GRID_API_TOKEN=

# MLS system to query. The demo feed is "carolina".
# Change when the production feed is connected.
MLS_GRID_ORIGINATING_SYSTEM_NAME=carolina

# --- Restrict the live search to Brian's own listings -----------------------
# Leave BOTH blank to show the whole market (standard IDX behaviour).
#
# Brian's MLS agent ID. Note: ListAgentMlsId is NOT searchable server-side,
# so this filters after fetching — it only works against a production feed
# that actually contains his listings. On the demo token it returns nothing.
MLS_GRID_AGENT_MLS_ID=

# Cheaper alternative: name his listing numbers directly. ListingId IS
# searchable, so this filters server-side in a single request. Comma-separated.
MLS_GRID_LISTING_IDS=

# --- Framed IDX (alternative to the API integration above) ------------------
# /search uses a vendor IDX embed when either of these is set, and falls back
# to the MLS Grid API search when they're blank.
#
# Canopy MLS approved vendors include IDX Broker, Showcase IDX,
# Buying Buddy / UltimateIDX, Web4Realty and AgentWebsite. They'll give you
# either an iframe URL or a script snippet — set whichever applies.
#
# NOTE: these are NEXT_PUBLIC_ because the embed runs in the browser. Never put
# the MLS Grid token in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_IDX_EMBED_URL=
NEXT_PUBLIC_IDX_SCRIPT_SRC=
NEXT_PUBLIC_IDX_WIDGET_ID=
